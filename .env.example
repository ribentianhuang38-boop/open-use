# TypeSafe Jev API Key (Get yours from https://typesafe.ai)
JEV_API_KEY=your_typesafe_jev_api_key_here
TYPESAFE_API_KEY=your_typesafe_jev_api_key_here

# Optional: TypeSafe Base URL (defaults to https://api.typesafe.ai/v1)
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# Optional: Chrome DevTools Protocol port (defaults to 9333)
# OPENUSE_CDP_PORT=9333
